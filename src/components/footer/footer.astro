---
import FooterBrand from "@/components/footer/FooterBrand.astro"
import FooterSocial from "@/components/footer/FooterSocial.astro"

const year = new Date().getFullYear();
const name = "Ashi Labs";
const username = "ajcastrob";
---
<style>
.footer {
  background: var(--color-surface-muted);
  border-top: var(--border-width) solid var(--color-border);
}
.footer__container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--max-width-frame);
  margin-inline: auto;
  padding: 48px var(--space-64);
  gap: var(--space-24);
}
.footer svg {
  width: 28px;
  height: 28px;
  color: currentColor;
}
@media (max-width: 800px) {
  .footer__container {
    padding-inline: var(--space-16);
    flex-wrap: wrap;
  }
}
</style>

<footer class="footer">
  <div class="footer__container">
    <FooterBrand name={name} year={year} username={username} />
    <FooterSocial />
  </div>
</footer>
