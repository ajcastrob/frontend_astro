---
const searchIcon = "/assets/icons/section.svg#search";
const { tags = [] } = Astro.props;

---
<style>
.search {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
  width: 100%;
  min-width: 0;
  margin: 0 0 var(--space-64);
  padding-bottom: var(--space-24);
  border-bottom: var(--border-width) solid var(--color-border);
}

.search__field {
  position: relative;
  min-width: 0;
}

.search__icon {
  position: absolute;
  left: var(--space-16);
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  pointer-events: none;
  color: var(--color-text-tertiary);
}

.search__input {
  width: 100%;
  min-height: 3.25rem;
  padding: var(--space-16);
  padding-left: calc(var(--space-16) + 18px + var(--space-8));
  font: inherit;
  font-size: 1rem;
  line-height: 1.25;
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
  transition: border-color var(--duration) var(--ease-out);
}

.search__input::placeholder {
  color: var(--color-text-tertiary);
}

.search__input:hover {
  border-color: var(--color-accent);
}

.search__input:focus {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-color: var(--color-accent);
}

.search__input::-webkit-search-cancel-button {
  appearance: none;
  width: 14px;
  height: 14px;
  margin-left: var(--space-8);
  background: var(--color-text-tertiary);
  mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18.3 5.71 12 12.01 5.7 5.7 4.29 7.11 10.59 13.4 4.29 19.7 5.7 21.11 12 14.82 18.3 21.12 19.71 19.71 13.41 13.4 19.71 7.11z'/></svg>") center / contain no-repeat;
  cursor: pointer;
}

.search__filters {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  min-width: 0;
}

.search__label {
  margin: 0;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}

.search__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-8);
  min-width: 0;
}

.search__chip {
  position: relative;
  display: inline-flex;
  cursor: pointer;
}

.search__chip input {
  position: absolute;
  inset: 0;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.search__chip-text {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0 var(--space-8);
  font-size: 13px;
  line-height: 1;
  white-space: nowrap;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
  pointer-events: none;
  transition:
    color var(--duration) var(--ease-out),
    background-color var(--duration) var(--ease-out),
    border-color var(--duration) var(--ease-out);
}

.search__chip:hover .search__chip-text {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.search__chip input:checked + .search__chip-text {
  color: var(--color-white);
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.search__chip:has(input:focus-visible) .search__chip-text {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.search__status {
  margin: 0;
  margin-top: 10px;
  font-size: 13px;
  color: var(--color-text-tertiary);
}

.search__empty {
  margin: 0;
  margin-top: 10px;
  max-width: 40rem;
  font-size: 1rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.search__empty[hidden],
.search__status[hidden] {
  display: none;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 800px) {
  .search {
    margin-bottom: var(--space-32);
  }
}

@media (prefers-reduced-motion: no-preference) {
  .search__chip:active .search__chip-text {
    transform: scale(0.98);
  }
}
</style>

<div class="search">
  <div class="search__field">
    <label class="visually-hidden" for="search-title">Buscar artículos</label>
    <svg class="search__icon" aria-hidden="true">
      <use href={searchIcon}></use>
    </svg>
    <input
      class="search__input"
      id="search-title"
      type="search"
      name="q"
      placeholder="Buscar artículos"
      autocomplete="off"
    />
  </div>

  <div class="search__filters">
    <p class="search__label" id="tag-filter-label">Etiqueta</p>
    <div
      class="search__chips"
      role="radiogroup"
      aria-labelledby="tag-filter-label"
    >
      <label class="search__chip">
        <input type="radio" name="tag-article" value="" checked>
        <span class="search__chip-text">Todas</span>
      </label>
      {tags.map((tag) => (
        <label class="search__chip">
          <input type="radio" name="tag-article" value={tag}>
          <span class="search__chip-text">{tag}</span>
        </label>
      ))}
    </div>
  </div>

  <p class="search__status" id="search-status" aria-live="polite"></p>
  <p class="search__empty" id="search-empty" hidden>
    Ningún artículo coincide con esa búsqueda.
  </p>
</div>

<script>
  import {
    selectedTag,
    getMatchesCard,
    getTotalPages,
    chageStatusPagination,
    resetPage,
    stepPage,
  } from "@/lib/search.js"

  const input = document.querySelector("#search-title")
  const chips = document.querySelector(".search__chips")
  const prev = document.querySelector("#pager-prev")
  const next = document.querySelector("#pager-next")

  function applyFilters() {
    const q = input.value.trim().toLowerCase()
    const selectTag = selectedTag()
    const matches = getMatchesCard(q, selectTag)
    const totalPages = getTotalPages(matches)

    document.querySelectorAll(".card").forEach((card) => {
      card.hidden = true
    })
    chageStatusPagination(matches, totalPages)
  }

  input.addEventListener("input", () => {
    resetPage()
    applyFilters()
  })
  chips.addEventListener("change", () => {
    resetPage()
    applyFilters()
  })
  prev.addEventListener("click", () => {
    stepPage(-1)
    applyFilters()
  })
  next.addEventListener("click", () => {
    stepPage(1)
    applyFilters()
  })
  applyFilters()
</script>
