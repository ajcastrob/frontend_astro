---
import { formatDate } from "@/lib/format.js";

const { date } = Astro.props;
---
<style>
.date {
  font-size: 14px;
  color: var(--color-text-tertiary);
}

.date time {
  font-family: var(--font-ui);
}
</style>

{date && (
  <div class="date">
    <time datetime={date}>{formatDate(date)}</time>
  </div>
)}
