---
const { author, avatar, authorName } = Astro.props
---
<style>
.article__author {
  display: flex;
  align-items: center;
  gap: var(--space-8);
}

.article__avatar {
  width: 32px;
  height: 32px;
  object-fit: cover;
  border-radius: 50%;
}

.article__author-name {
  margin: 0;
  font-size: 14px;
  font-weight: 500;
  color: var(--color-text-tertiary);
}
</style>

{author && (
  <div class="article__author">
    {avatar && <img class="article__avatar" src={avatar} alt="" />}
    <p class="article__author-name">{authorName}</p>
  </div>
)}
