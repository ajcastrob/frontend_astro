---
import BasicLayout from "@/layouts/BasicLayout.astro"
import Date from "@/components/date/Date.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"


export async function getStaticPaths() {
  const posts = (await getBlogPost()) ?? []
  return posts.map((post) => ({
    params: { slug: post.meta.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const cover = imageUrl(post.image)
const author = post.owner
const authorName = [author?.first_name, author?.last_name].filter(Boolean).join(" ") || author?.username || ""
const avatar = author?.profile_picture ? imageUrl({ url: author.profile_picture }) : ""
---

<style>
.article {
  max-width: var(--max-width-hero);
  margin-inline: auto;
  padding: 96px var(--space-64);
}
.article__header {
  margin-bottom: var(--space-64);
}
.article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-8);
  margin: 0 0 var(--space-24);
  padding: 0;
}
.article__tag {
  padding: var(--space-4) var(--space-8);
  font-size: 13px;
  font-weight: 700;
  color: var(--color-accent);
}
.article__title {
  margin: 0 0 var(--space-24);
  font-family: var(--font-display);
  font-size: var(--font-size-display);
  font-weight: 500;
  line-height: 1.1;
  color: var(--color-text-primary);
}
.article__intro {
  margin: 0;
  font-size: 24px;
  line-height: 1.4;
  color: var(--color-text-secondary);
}
.article__figure {
  margin: 0 0 var(--space-64);
}
.article__img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--radius);
}
.article__caption {
  margin-top: var(--space-16);
  font-size: 15px;
  color: var(--color-text-secondary);
}
.article-body p {
  font-family: var(--font-display);
  font-size: 18px;
  line-height: 1.7;
  color: var(--color-text-primary);
}
.article-body h2 {
  font-family: var(--font-ui);
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
}
.article__repo {
  margin-top: var(--space-64);
  padding-top: var(--space-32);
  border-top: var(--border-width) solid var(--color-border);
}
.article__repo a {
  color: var(--color-accent);
}


.article__author {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-top: var(--space-32);
}
.article__avatar {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: 50%;
}
.article__author-name {
  margin: 0;
  font-weight: 600;
  color: var(--color-text-primary);
}


@media (max-width: 800px) {
  .article {
    padding: var(--space-64) var(--space-16);
  }
  .article__title {
    font-size: 32px;
  }
}

</style>


<BasicLayout title={post.title}>
  <article class="article">
    <header class="article__header">
      {post.tags?.length > 0 && (
        <ul class="article__tags">
          {post.tags.map((tag) => (
            <li class="article__tag">{tag}</li>
          ))}
        </ul>
      )}
      <h1 class="article__title">{post.title}</h1>
      {post.intro && <p class="article__intro">{post.intro}</p>}
      
      <Date date={post.date}/>

      {author && (
        <div class="article__author">
          {avatar && <img class="article__avatar" src={avatar} alt="" />}
          <p class="article__author-name">{authorName}</p>
        </div>
      )}


    </header>



    {cover && (
      <figure class="article__figure">
        <img
          class="article__img"
          src={cover}
          alt={post.image?.title ?? ""}
        />
        {post.caption && (
          <figcaption class="article__caption">{post.caption}</figcaption>
        )}
      </figure>
    )}

    {post.body && <div class="article-body" set:html={post.body} />}

    {post.repo_url && (
      <p class="article__repo">
        <a href={post.repo_url} rel="noopener noreferrer" target="_blank">
          Ver repositorio
        </a>
      </p>
    )}
  </article>
</BasicLayout>


