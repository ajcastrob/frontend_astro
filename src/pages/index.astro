---
import BasicLayout from "@/layouts/BasicLayout.astro"
import Hero from "@/components/hero/Hero.astro"
import SkillCard from "@/components/cards/SkillCard.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"

const posts = await getBlogPost();
const latest = (posts ?? []).slice(0, 3)
---

<style>
.skills {
  max-width: var(--max-width-content);
  margin-inline: auto;
  padding: 0 var(--space-64) var(--space-128);
}
.skills__head {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-bottom: var(--space-64);
}
.skills__title {
  margin: 0;
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}
.skills__rule {
  flex: 1;
  height: var(--border-width);
  background: var(--color-border);
  border: 0;
}
.skills__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-24);
}
</style>

<BasicLayout>
  <Hero />

  <section class="skills">
    <div class="skills__head">
      <h2 class="skills__title">Artículos recientes</h2>
      <hr class="skills__rule" />
    </div>

    {latest.length === 0 ? (
      <p>Aún no hay artículos publicados.</p>
    ) : (
      <div class="skills__grid">
        {latest.map((post) => (
          <SkillCard
            title={post.title}
            intro={post.intro}
            tags={post.tags}
            href={`/skills/${post.meta.slug}`}
            imageSrc={imageUrl(post.image)}
            imageAlt={post.image?.title ?? ""}
          />
        ))}
      </div>
    )}
  </section>
</BasicLayout>

