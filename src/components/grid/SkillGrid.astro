---
import SkillCard from "@/components/cards/SkillCard.astro"

const { posts, imageUrl } = Astro.props

---
<style>
.skills__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-24);
}

@media (max-width: 800px) {
  .skills__grid {
    grid-template-columns: 1fr;
  }
}
</style>


<div class="skills__grid">
        {posts.map((post) => (
          <SkillCard
            title={post.title}
            intro={post.intro}
            tags={post.tags}
            href={`/skills/${post.meta.slug}`}
            imageSrc={imageUrl(post.image)}
            imageAlt={post.image?.title ?? ""}

          />
        ))}
</div>

