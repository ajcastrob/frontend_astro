---
import BasicLayout from "@/layouts/BasicLayout.astro"
import CoverArticle from "@/components/article/CoverArticle.astro"
import HeaderArticle from "@/components/article/header_article/HeaderArticle.astro"
import RepoArticle from "@/components/article/RepoArticle.astro"
import BodyArticle from "@/components/article/BodyArticle.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"


export async function getStaticPaths() {
  const posts = (await getBlogPost()) ?? []
  return posts.map((post) => ({
    params: { slug: post.meta.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const cover = imageUrl(post.image)
const author = post.owner
const authorName = [author?.first_name, author?.last_name].filter(Boolean).join(" ") || author?.username || ""
const avatar = author?.profile_picture ? imageUrl({ url: author.profile_picture }) : ""
---
<style>
.article {
  max-width: min(var(--max-width-hero), 100%);
  margin-inline: auto;
  padding: 96px var(--space-64);
  min-width: 0;
}
@media (max-width: 800px) {
  .article {
    padding: var(--space-64) var(--space-16);
  }
}
</style>

<BasicLayout title={post.title}>
  <article class="article"> 
    <HeaderArticle post={ post } authorName={ authorName } avatar={ avatar } author={author} /> 
    <CoverArticle cover={ cover } post={ post } /> 
    <BodyArticle post={ post } />
    <RepoArticle  post={ post }/>
  </article>
</BasicLayout>


