---
const { linkLogo, nameBrand } = Astro.props
---
<style>
.header__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  color: var(--color-text-primary);
}

.header__mark {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  overflow: hidden;
  flex-shrink: 0;
  color: currentColor;
  border-radius: 16px;
}

.header__title {
  min-width: 0;
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  line-height: 24px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

@media (max-width: 360px) {
  .header__title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
}

svg {
  display: block;
  width: 32px;
  height: 32px;
}
</style>

<a class="header__brand" href="/">
  <span class="header__mark" aria-hidden="true">
    <svg>
      <use href={linkLogo}></use>
    </svg>
  </span>
  <span class="header__title">
    {nameBrand}
  </span>
</a>
