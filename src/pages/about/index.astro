---
import BasicLayout from "@/layouts/BasicLayout.astro"
import PilaresSection from "@/components/section/PilaresSection.astro"
import AboutHero from "@/components/section/AboutHero.astro"
import StoryContent from "@/components/section/StoryContent.astro"
---

<style> 
  .story {
    background-color: var(--color-surface-muted);
    padding: var(--space-128) var(--space-64);
  }

  .story__container {
    display: flex;
    align-items: center;
    gap: 96px;
    max-width: var(--max-width-content);
    margin-inline: auto;
  }
 
  .story__image-wrapper {
    flex: 1;
  }

  .story__image {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #dde0e3;
    border-radius: var(--radius);
    object-fit: cover;
  }

  @media (max-width: 800px) {
    .story {
      padding: var(--space-64) var(--space-16);
    }

    .story__container {
      flex-direction: column;
      gap: var(--space-32);
    }
  }
</style>

<BasicLayout title="Sobre Ashi Labs">
  <AboutHero /> 
  <section class="story">
    <div class="story__container">
      <StoryContent /> 
      <div class="story__image-wrapper">
        <img class="story__image" src="/laptop.webp" alt="Escritorio con laptop" />
      </div>
    </div>
  </section>
  <PilaresSection />
</BasicLayout>

