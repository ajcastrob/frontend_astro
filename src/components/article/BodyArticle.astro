---
const { post } = Astro.props
---

<style>
.article-body p {
  font-family: var(--font-display);
  font-size: 18px;
  line-height: 1.7;
  color: var(--color-text-primary);
}
.article-body h2 {
  font-family: var(--font-ui);
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
}
</style>


{post.body && <div class="article-body" set:html={post.body} />}
