---
import BasicLayout from "@/layouts/BasicLayout.astro"
import Posts from "@/components/posts/Posts.astro"
import Search from "@/components/search/Search.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"

const posts = (await getBlogPost()) ?? []
const allTags = [...new Set(posts.flatMap(post => post.tags || []))].slice(0,10);
---
<style>
.skills {
  max-width: min(var(--max-width-content), 100%);
  margin-inline: auto;
  padding: var(--space-64) var(--space-64) var(--space-128);
  min-width: 0;
}
.skills__intro {
  max-width: 40rem;
  margin-bottom: var(--space-64);
  min-width: 0;
}
.skills__h1 {
  margin: 0 0 var(--space-16);
  font-family: var(--font-display);
  font-size: var(--font-size-h2);
  font-weight: 500;
  line-height: 1.15;
  color: var(--color-text-primary);
  text-wrap: balance;
}
.skills__lead {
  margin: 0;
  font-size: var(--font-size-nav);
  line-height: 1.6;
  color: var(--color-text-secondary);
  overflow-wrap: break-word;
}

.skills__search {
  width: 100%;
  min-width: 0;
}

.pager {
  display: flex;
  justify-content: center;
  gap: var(--space-16);
  margin-top: var(--space-64);
}
.pager[hidden] {
  display: none;
}
.pager button {
  font: inherit;
  padding: var(--space-8) var(--space-16);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
  cursor: pointer;
}
.pager button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (max-width: 800px) {
  .skills { padding-inline: var(--space-16); }
}
</style>

<BasicLayout title="Skills">
  <section class="skills">
    <header class="skills__intro">
      <h1 class="skills__h1">Biblioteca de artículos</h1>
      <p class="skills__lead">Un archivo de ideas, técnicas y reflexiones sobre la intersección entre la curiosidad humana y la capacidad de la IA.</p>
    </header>
    
    <div class="skills__search">
      <Search tags={ allTags } />
    </div>

    <Posts posts={ posts } imageUrl={ imageUrl } />


    <nav class="pager" id="search-pager" aria-label="Paginación">
      <button type="button" id="pager-prev">Anterior</button>
      <button type="button" id="pager-next">Siguiente</button>
    </nav>

  </section>
</BasicLayout>


