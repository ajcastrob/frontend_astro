---
interface Props {
  title?: string
  items?: Array<{ icon: string; title: string; description: string }>
}

const {
  title = "¿Por qué leer Ashi Labs?",
  items = [
    {
      icon:"/assets/icons/section.svg#robot" ,
      title: "Skills prácticas",
      description: "Cada artículo es una skill documentada paso a paso, sin teoría vacía.",
    },
    {
      icon: "/assets/icons/section.svg#flashlight",
      title: "Sin improvisación",
      description: "Solo herramientas que de verdad funcionan — probadas, no prometidas.",
    },
    {
      icon: "/assets/icons/section.svg#walk",
      title: "A tu ritmo",
      description: "De lo básico a lo avanzado, sin prisa pero sin pausa.",
    },
  ],
} = Astro.props
---

<style>
.why {
  background-color: var(--color-white);
  padding: var(--space-128) var(--space-64);
}

.why__title {
  margin: 0 0 var(--space-32) 0;
  font-family: var(--font-display);
  font-size: var(--font-size-display);
  font-weight: 500;
  line-height: 1.2;
  color: var(--color-text-primary);
  text-align: center;
}

.why__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-32);
  max-width: var(--max-width-content);
  margin-inline: auto;
}

.why__item {
  text-align: center;
}

.why__icon {
  font-size: 2rem;
  line-height: 1;
}

svg {
  width: 4rem;
}

.why__item-title {
  margin: 0 0 var(--space-8) 0;
  font-family: var(--font-ui);
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
}

.why__item-desc {
  margin: 0;
  width: 100%;
  font-family: var(--font-ui);
  font-size: 18px;
  font-weight: 400;
  line-height: 1.625;
  color: var(--color-text-secondary);
}

@media (max-width: 800px) {
  .why {
    padding: var(--space-64) var(--space-16);
  }

  .why__title {
    font-size: 2.5rem;
  }

  .why__grid {
    grid-template-columns: 1fr;
  }

  .why__item-desc {
    font-size: 16px;
  }
}
</style>

<section class="why">
  <h2 class="why__title">{title}</h2>
  <div class="why__grid">
    {items.map((item) => (
      <div class="why__item">
      <span class="why__icon">
        <svg aria-hidden="true">
          <use href={ item.icon }></use>
        </svg>
      </span>
        <h3 class="why__item-title">{item.title}</h3>
        <p class="why__item-desc">{item.description}</p>
      </div>
    ))}
  </div>
</section>
