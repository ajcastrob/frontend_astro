---
const { title } = Astro.props
---
<style>
.card__title {
  margin: 0 0 var(--space-16);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 500;
  line-height: 1.2;
  color: var(--color-text-primary);
  text-wrap: balance;
  overflow-wrap: break-word;
  transition: color var(--duration) var(--ease-out);
}
</style>

<h3 class="card__title">{title}</h3>
