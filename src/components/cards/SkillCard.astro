---
import ImageCard from "@/components/cards/ImageCard.astro"
import TagsCard from "@/components/cards/TagsCard.astro"
import IntroCard from "@/components/cards/IntroCard.astro"
import TitleCard from "@/components/cards/TitleCard.astro"
import LinkCard from "@/components/cards/LinkCard.astro"
const { title, intro, imageSrc = "", imageAlt= "", tags = [], href } = Astro.props
---
<style>
.card {
  display: flex;
  flex-direction: column;
  padding: var(--space-24);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
}
</style>

<article class="card">
  <ImageCard imageSrc={ imageSrc } alt={ imageAlt } />
  <TagsCard tags={ tags } />
  <TitleCard href={ href } title={ title } />
  <IntroCard intro={ intro } />
  <LinkCard href={ href } />
</article>

