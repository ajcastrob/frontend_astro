---
import Social from "@/components/social/Social.astro"
---
<style>
.header__social {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  gap: var(--space-32);
}

.header__social-link{
  display: inline-block;
  border-radius: var(--radius);
  padding: 8px 24px;
  background-color: var(--color-accent);
  color: var(--color-white);
  text-transform: uppercase;
}

@media (max-width: 800px) {
  .header__social {
    display: none;
  }
}
</style>

<ul class="header__social">
  <li>
    <a class="header__social-link" href="/#newsletter-section">
      Suscribirse
    </a>
  </li>
</ul>

