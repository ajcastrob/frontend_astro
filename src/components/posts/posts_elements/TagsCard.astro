---
const { tags } = Astro.props
---
<style>
.card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-8);
  margin: 0 0 var(--space-16);
  padding: 0;
}

.card__tag {
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}

.card__tag:not(:first-child) {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

{tags.length > 0 && (
  <ul class="card__tags">
    {tags.map((tag) => (
      <li class="card__tag">{tag}</li>
    ))}
  </ul>
)}
