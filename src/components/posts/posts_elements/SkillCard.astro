---
import ImageCard from "@/components/posts/posts_elements/ImageCard.astro"
import TagsCard from "@/components/posts/posts_elements/TagsCard.astro"
import IntroCard from "@/components/posts/posts_elements/IntroCard.astro"
import TitleCard from "@/components/posts/posts_elements/TitleCard.astro"
import LinkCard from "@/components/posts/posts_elements/LinkCard.astro"

const {
  title,
  intro,
  imageSrc = "",
  imageAlt = "",
  tags = [],
  href,
  date,
  featured = false,
} = Astro.props
---
<style>
.card {
  min-width: 0;
}

.card[hidden] {
  display: none;
}

.card__hit {
  display: grid;
  gap: var(--space-24);
  min-width: 0;
  color: inherit;
}

.card--lead .card__hit {
  align-items: center;
  padding-bottom: var(--space-64);
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
}

.card--lead .card__hit:not(:has(:global(.card__media))) {
  grid-template-columns: 1fr;
}

.card--row .card__hit {
  align-items: start;
  padding-block: var(--space-32);
  border-top: var(--border-width) solid var(--color-border);
  grid-template-columns: minmax(0, 1fr) auto;
}

.card--row .card__hit:not(:has(:global(.card__media))) {
  grid-template-columns: 1fr;
}

.card--row:first-child .card__hit {
  border-top: 0;
  padding-top: 0;
}

.card__copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.card--lead :global(.card__title) {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.4vw, 2.75rem);
  font-weight: 500;
  letter-spacing: -0.02em;
}

@media (prefers-reduced-motion: no-preference) {
  .card__hit:hover :global(.card__title) {
    color: var(--color-accent);
  }

  .card__hit:hover :global(.card__img) {
    transform: scale(1.03);
  }

  .card__hit:hover :global(.card__leer-icon) {
    transform: translateX(4px);
  }

  .card__hit:active {
    transform: scale(0.995);
  }
}

@media (max-width: 800px) {
  .card--lead .card__hit {
    grid-template-columns: 1fr;
    gap: var(--space-16);
    padding-bottom: var(--space-32);
  }

  .card--row .card__hit {
    padding-block: var(--space-24);
  }
}
</style>

<article class:list={["card", featured ? "card--lead" : "card--row"]}>
  <a class="card__hit" href={href}>
    <div class="card__copy">
      <TagsCard tags={tags} />
      <TitleCard title={title} />
      <IntroCard intro={intro} compact={!featured} />
      <LinkCard date={date} featured={featured} />
    </div>
    <ImageCard imageSrc={imageSrc} imageAlt={imageAlt} variant={featured ? "lead" : "row"} />
  </a>
</article>
