---
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME
---
<style>
.newsletter {
  margin-top: var(--space-128);
  max-width: 40rem;
  min-width: 0;
}
.newsletter__title {
  margin: 0 0 var(--space-16);
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
}
.newsletter__lead {
  margin: 0 0 var(--space-32);
  color: var(--color-text-secondary);
}
.newsletter__form {
  display: grid;
  gap: var(--space-16);
}
.newsletter__form label {
  font-size: var(--font-size-nav);
  color: var(--color-text-tertiary);
}
.newsletter__form input[type="text"],
.newsletter__form input[type="email"] {
  width: 100%;
  padding: var(--space-16);
  font: inherit;
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
}
.newsletter__form input:focus {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-color: var(--color-accent);
}
.newsletter__form button {
  justify-self: start;
  padding: var(--space-16) var(--space-32);
  font: inherit;
  color: var(--color-white);
  background: var(--color-accent);
  border: 0;
  border-radius: var(--radius);
  cursor: pointer;
}
.newsletter__form button:hover {
  filter: brightness(1.08);
}
@media (max-width: 800px) {
  .newsletter { margin-top: var(--space-64); }
}
</style>


{username && (
  <section class="newsletter">
    <h2 class="newsletter__title">Newsletter</h2>
    <p class="newsletter__lead">Déjanos tu nombre y correo y te avisamos de skills nuevas</p>
    <form
      class="newsletter__form"
      action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
      method="post"
    >
      <label for="bd-name">Nombre</label>
      <input id="bd-name" type="text" name="metadata__name" required autocomplete="name" />
      <label for="bd-email">Email</label>
      <input id="bd-email" type="email" name="email" required autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Suscribirme</button>
    </form>
  </section>
)}

