---
import Date from "@/components/date/Date.astro"
import TagsArticle from "@/components/article/TagsArticle.astro"
import AuthorArticle from "@/components/article/AuthorArticle.astro"
import IntroArticle from "@/components/article/IntroArticle.astro"

const { post, authorName, avatar, author  } = Astro.props
---
<style>
.article__header {
  margin-bottom: var(--space-64);
}
.article__title {
  margin: 0 0 var(--space-24);
  font-family: var(--font-display);
  font-size: var(--font-size-display);
  font-weight: 500;
  line-height: 1.1;
  color: var(--color-text-primary);
}

@media (max-width: 800px) {
  .article__title {
    font-size: 32px;
  }
}
</style>

<header class="article__header">
      <TagsArticle post={post} />
      <h1 class="article__title">{post.title}</h1>
      <IntroArticle post={post} /> 
      <Date date={post.date}/>
      <AuthorArticle author={ author } avatar={ avatar } authorName={ authorName } />
</header>

