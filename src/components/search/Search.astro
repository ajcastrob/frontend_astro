---
const searchIcon = "/assets/icons/section.svg#search"
---
<style>
.search {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 40rem;
  margin: 0 0 var(--space-64);
  min-width: 0;
}
.search__icon {
  position: absolute;
  left: var(--space-16);
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  pointer-events: none;
  color: var(--color-text-tertiary);
}
.search__input {
  width: 100%;
  padding: var(--space-16) var(--space-16) var(--space-16) calc(var(--space-16) + 18px + var(--space-8));
  font: inherit;
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
}
.search__input::placeholder {
  color: var(--color-text-tertiary);
}
.search__input:focus {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-color: var(--color-accent);
}
@media (max-width: 800px) {
  .search { margin-bottom: var(--space-32); }
}
</style>

<div class="search">
  <svg class="search__icon" aria-hidden="true">
    <use href={ searchIcon }></use>
  </svg>
  <input
    class="search__input"
    id="search-title"
    type="search"
    name="q"
    placeholder="Buscar..."
    autocomplete="off"
  />
</div>

<script>
  const input = document.querySelector("#search-title")
  const cards = document.querySelectorAll(".card")

  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase()
    cards.forEach((card) => {
      const title = card.querySelector(".card__title").textContent.toLowerCase()
      card.hidden = q !== "" && !title.includes(q)
    })
  })
</script>
