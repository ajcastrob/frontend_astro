---
import HeroImage from "@/components/hero/HeroImage.astro"
---

<style>
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: var(--space-64);
  width: 100%;
  max-width: min(var(--max-width-content), 100%);
  margin-inline: auto;
  padding: var(--space-64);
  min-width: 0;
}

.hero > :global(*) {
  min-width: 0;
  max-width: 100%;
}

.hero__copy {
  display: flex;
  flex-direction: column;
  max-width: 32rem;
  min-width: 0;
}

.hero__title {
  margin: 0 0 var(--space-16);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  font-family: var(--font-display);
  font-size: var(--font-size-h1);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: var(--color-text-primary);
  overflow-wrap: break-word;
}

.hero__title em {
  font-style: italic;
  font-weight: inherit;
  color: var(--color-accent);
}

.hero__lead {
  margin: 0;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  font-size: var(--font-size-subtitle);
  line-height: 1.7;
  color: var(--color-text-secondary);
  overflow-wrap: break-word;
}

@media (prefers-reduced-motion: no-preference) {
  .hero :global(.hero__media),
  .hero__title,
  .hero__lead {
    animation: hero-in 720ms var(--ease-out) both;
  }

  .hero__title {
    animation-delay: 90ms;
  }

  .hero__lead {
    animation-delay: 180ms;
  }
}

@keyframes hero-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@media (min-width: 801px) {
  .hero__title {
    text-wrap: balance;
  }
}

@media (max-width: 800px) {
  .hero {
    grid-template-columns: 1fr;
    gap: var(--space-32);
    padding: var(--space-64) var(--space-16);
  }

  .hero__copy {
    max-width: 100%;
  }

  .hero__title {
    font-size: 2rem;
  }
}
</style>

<section class="hero">
  <div class="hero__copy">
    <h1 class="hero__title">
      Dominando skills de IA: 
      <div>
          Del prompt a <em>la automatización</em>
      </div>
    </h1>
    <p class="hero__lead">
      Un espacio para explorar herramientas de IA. Sin mucha prisa, a pasos con el desarrollo.
    </p>
  </div>
  <HeroImage />
</section>
