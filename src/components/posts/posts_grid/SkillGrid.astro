---
import SkillCard from "@/components/posts/posts_elements/SkillCard.astro"

const { posts, imageUrl, featured = false } = Astro.props
---
<style>
.skills__grid {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.skills__grid > :global(*) {
  min-width: 0;
}
</style>

<div class:list={["skills__grid", featured && "skills__grid--featured"]}>
  {posts.map((post, index) => (
    <SkillCard
      title={post.title}
      intro={post.intro}
      tags={post.tags}
      href={`/skills/${post.meta.slug}`}
      imageSrc={imageUrl(post.image)}
      imageAlt={post.image?.title ?? ""}
      date={post.date || post.meta?.first_published_at}
      featured={featured && index === 0}
    />
  ))}
</div>
