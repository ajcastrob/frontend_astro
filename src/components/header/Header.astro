---
import HeaderNav from "@/components/header/HeaderNav.astro"
import HeaderBrand from "@/components/header/HeaderBrand.astro"
import HeaderSocial from "@/components/header/HeaderSocial.astro"

const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const isHome = path === "/"
const isSkills = path === "/skills" || path.startsWith("/skills/")
const linkLogo = "/assets/icons/logo.svg#logo" 
const nameBrand = "Ashi Labs"
---
<style>
.header {
  position: sticky;
  top: 0;
  z-index: var(--z-header);
  width: 100%;
  max-width: 100%;
  background: var(--color-surface);
  border-bottom: var(--border-width) solid var(--color-border);
}
.header__container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: var(--max-width-frame);
  margin-inline: auto;
  padding: var(--space-16) var(--space-64);
  gap: var(--space-24);
  min-width: 0;
}
@media (max-width: 800px) {
  .header__container {
    padding-inline: var(--space-16);
    flex-wrap: wrap;
    gap: var(--space-16);
    min-width: 0;
  }
}
</style>

<header class="header">
  <div class="header__container">
    <HeaderBrand linkLogo={ linkLogo } nameBrand={ nameBrand } />
    <HeaderNav isHome={ isHome } isSkills={isSkills} />
    <HeaderSocial />
  </div>
</header>
