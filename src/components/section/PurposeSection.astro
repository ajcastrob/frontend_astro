---
interface Props {
  title?: string
  description?: string
}

const {
  title = "Nuestro Propósito",
  description =`Ashi Labs es un espacio donde se recopila,  
                prueba y documenta las herramientas de IA que merecen tu tiempo.
                Cada skill es un paso — como la palabra Ashi, cuyo signficado es dar pasos 
                silenciosos pero certeros.`,
} = Astro.props
---

<style>
.section {
  margin-top: var(--space-128);
  background-color: var(--color-surface-muted);
  padding: var(--space-128) var(--space-128);
  border-top: 1px solid var(--color-border);
}

.section__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-24);
  max-width: 720px;
  margin-inline: auto;
  padding-inline: 20px;
}

.section__logo {
  width: 80px;
  height: 80px;
  display: flex;
  margin-inline: auto;
}

.section__logo svg {
  width: 100%;
  height: 100%;
}

.section__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--font-size-display);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.96px;
  color: var(--color-text-primary);
  text-align: center;
}

.section__description {
  margin: 0;
  font-family: var(--font-ui);
  font-size: 18px;
  font-weight: 400;
  line-height: 1.625;
  color: var(--color-text-secondary);
  text-align: center;
}

@media (max-width: 800px) {
  .section {
    padding: var(--space-64) var(--space-16);
  }

  .section__title {
    font-size: 2.5rem;
  }

  .section__description {
    font-size: 16px;
  }
}
</style>

<section class="section">
  <div class="section__inner">
    <div class="section__logo">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <path fill="currentColor" fill-rule="evenodd" d="M100 24a76 76 0 1 1 0 152 76 76 0 1 1 0-152m15.51 37.61-1.45 32.42 24.33 21.48-32.42-1.45-21.48 24.33 1.45-32.42-24.33-21.48 32.42 1.45zM100 93.7a6.3 6.3 0 1 1 0 12.6 6.3 6.3 0 1 1 0-12.6"/>
      </svg>
    </div>
    <h2 class="section__title">{title}</h2>
    <p class="section__description">{description}</p>
  </div>
</section>
