---
const { imageSrc, imageAlt, variant = "row" } = Astro.props
---
<style>
.card__media {
  overflow: hidden;
  min-width: 0;
  background: var(--color-surface-muted);
}

.card__media--lead {
  border-radius: var(--radius-lg);
}

.card__media--row {
  width: 160px;
  border-radius: 16px;
}

.card__img {
  display: block;
  width: 100%;
  object-fit: cover;
  transition: transform var(--duration) var(--ease-out);
}

.card__media--lead .card__img {
  aspect-ratio: 4 / 3;
}

.card__media--row .card__img {
  aspect-ratio: 5 / 4;
}

@media (max-width: 800px) {
  .card__media--row {
    width: 96px;
  }
}
</style>

{imageSrc && (
  <div class:list={["card__media", `card__media--${variant}`]}>
    <img class="card__img" src={imageSrc} alt={imageAlt ?? ""} />
  </div>
)}
