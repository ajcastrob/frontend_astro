---

import Social from "@/components/social/Social.astro"

---
<style>
.header {
  background: var(--color-surface);
  border-bottom: var(--border-width) solid var(--color-border);
}
.header__container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--max-width-frame);
  margin-inline: auto;
  padding: var(--space-16) var(--space-64);
  gap: var(--space-24);
}
.header__brand {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  color: var(--color-text-primary);
}
.header__title {
  font-family: var(--font-display);
  font-size: var(--font-size-brand);
  font-weight: 600;
}
.header__menu,
.header__social {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  gap: var(--space-32);
}
.header__link {
  font-size: var(--font-size-nav);
  color: var(--color-text-secondary);
}
.header__link[aria-current="page"] {
  color: var(--color-accent);
  border-bottom: var(--border-width) solid var(--color-accent);
}
.header svg {
  width: 28px;
  height: 28px;
  color: var(--color-text-primary);
}


@media (max-width: 800px) {
  .header__container {
    padding-inline: var(--space-16);
    flex-wrap: wrap;
    gap: var(--space-16);
  }
  .header__menu,
  .header__social {
    gap: var(--space-16);
  }
}


</style>

<header class="header">
  <div class="header__container">
    <a class="header__brand" class="link" href="/">
      <svg  aria-hidden="true">
        <use href="/assets/icons/logo.svg#logo"></use>
      </svg>
      <span class="header__title">
        Ashi Labs
      </span>
    </a>
    <nav class="header__nav">
      <ul class="header__menu">
        <li>
          <a class="header__link" href="/">
            Home
          </a>
        </li>
        <li>
          <a class="header__link" href="/skills/">
            Skills
          </a>
        </li>
      </ul>
    </nav>
    <ul class="header__social">
      <li>
        <Social link="https://github.com/ajcastrob" label="Github" icon="/assets/icons/social.svg#github" />
      </li>
      <li>
        <Social link="https://www.linkedin.com/in/jos%C3%A9-castro-b600791a4/" label="Linkedin" icon="/assets/icons/social.svg#linkedin" />
      </li>
    </ul>
  </div>
</header>
