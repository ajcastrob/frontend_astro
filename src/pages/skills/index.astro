---
import BasicLayout from "@/layouts/BasicLayout.astro"
import SkillCard from "@/components/cards/SkillCard.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"

const posts = (await getBlogPost()) ?? []
---

<style>
.skills {
  max-width: var(--max-width-content);
  margin-inline: auto;
  padding: 0 var(--space-64) var(--space-128);
}
.skills__head {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-bottom: var(--space-64);
}
.skills__title {
  margin: 0;
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}
.skills__rule {
  flex: 1;
  height: var(--border-width);
  background: var(--color-border);
  border: 0;
}
.skills__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-24);
}
</style>


<BasicLayout title="Skills">
  <section class="skills">
    <header class="skills__intro">
      <h1 class="skills__h1">Biblioteca de artículos</h1>
      <p class="skills__lead">Un archivo de ideas, técnicas y reflexiones sobre la intersección entre la curiosidad humana y la capacidad de la IA.</p>
    </header>

    {posts.length === 0 ? (
      <p>Aún no hay skills publicadas.</p>
    ) : (
      <div class="skills__grid">
        {posts.map((post) => (
          <SkillCard
            title={post.title}
            intro={post.intro}
            tags={post.tags}
            href={`/skills/${post.meta.slug}`}
            imageSrc={imageUrl(post.image)}
            imageAlt={post.image?.title ?? ""}

          />
        ))}
      </div>
    )}
  </section>
</BasicLayout>


