---
const { post } = Astro.props
---
<style>
.article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-16);
  margin: 0 0 var(--space-16);
  padding: 0;
}

.article__tag {
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}
</style>

{post.tags?.length > 0 && (
  <ul class="article__tags">
    {post.tags.map((tag) => (
      <li class="article__tag">{tag}</li>
    ))}
  </ul>
)}
