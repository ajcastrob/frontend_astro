---
import { formatDate } from "@/lib/format.js"

const { date, featured = false } = Astro.props
const formatted = formatDate(date)
---
<style>
.card__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-16);
  margin-top: auto;
  font-size: 14px;
  color: var(--color-text-tertiary);
}

.card__leer {
  display: inline-flex;
  align-items: center;
  gap: var(--space-4);
  font-weight: 500;
  color: var(--color-accent);
}

.card__leer-icon {
  display: inline-block;
  transition: transform var(--duration) var(--ease-out);
}
</style>

{(formatted || featured) && (
  <div class="card__meta">
    {formatted && (
      <time datetime={date}>{formatted}</time>
    )}
    {featured && (
      <span class="card__leer">
        Leer
        <span class="card__leer-icon" aria-hidden="true">→</span>
      </span>
    )}
  </div>
)}
