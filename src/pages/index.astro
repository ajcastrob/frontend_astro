---
import BasicLayout from "@/layouts/BasicLayout.astro"
import Hero from "@/components/hero/Hero.astro"
import Posts from "@/components/posts/Posts.astro"
import { getBlogPost, imageUrl } from "@/lib/wagtail.js"

const posts = await getBlogPost();
const latest = (posts ?? []).slice(0, 3)
---
<style>
.skills {
  max-width: min(var(--max-width-content), 100%);
  margin-inline: auto;
  padding: 0 var(--space-64) var(--space-128);
  min-width: 0;
}
.skills__head {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-bottom: var(--space-64);
}
.skills__title {
  margin: 0;
  font-size: var(--font-size-h2);
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
  text-wrap: balance;
}
.skills__rule {
  flex: 1;
  height: var(--border-width);
  background: var(--color-border);
  border: 0;
}

@media (max-width: 800px) {
  .skills { padding-inline: var(--space-16); }
}
</style>

<BasicLayout>
  <Hero/>
  <section class="skills">
    <div class="skills__head">
      <h2 class="skills__title">Artículos recientes</h2>
      <hr class="skills__rule" />
    </div>
    <Posts posts={ latest } imageUrl={ imageUrl } featured />
  </section>
</BasicLayout>

