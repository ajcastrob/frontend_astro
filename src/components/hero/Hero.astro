<style>
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-16);
  width: auto;
  min-height: 400px;
  margin-inline: var(--space-16);
  margin-top: calc(-1 * (var(--space-16) + 56px));
  margin-bottom: var(--space-64);
  padding: 108px var(--space-64) 48px;
  overflow: clip;
  text-align: center;
  background: var(--color-surface-warm);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}

.hero__eyebrow {
  margin: 0;
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}

.hero__title {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0;
  font-family: var(--font-display);
  font-size: 56px;
  font-weight: 500;
  line-height: 64px;
  letter-spacing: -1.1px;
  color: var(--color-text-primary);
}

.hero__title em {
  padding-bottom: 4px;
  font-style: italic;
  font-weight: 500;
  line-height: 1.15;
  color: var(--color-accent);
}

@media (prefers-reduced-motion: no-preference) {
  .hero__eyebrow,
  .hero__title {
    animation: hero-in 720ms var(--ease-out) both;
  }

  .hero__title {
    animation-delay: 90ms;
  }
}

@keyframes hero-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@media (min-width: 801px) {
  .hero__title span,
  .hero__title em {
    white-space: nowrap;
  }
}

@media (max-width: 800px) {
  .hero {
    min-height: 0;
    margin-inline: var(--space-16);
    padding: 96px var(--space-16) var(--space-32);
  }

  .hero__title {
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
}
</style>

<section class="hero">
  <p class="hero__eyebrow">El blog de Ashi Labs</p>
  <h1 class="hero__title">
    <span>Dominando skills de IA</span>
    <em>Del prompt a la automatización</em>
  </h1>
</section>
