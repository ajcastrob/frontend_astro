---
const { post } = Astro.props
---
<style>
.article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-8);
  margin: 0 0 var(--space-24);
  padding: 0;
}
.article__tag {
  padding: var(--space-4) var(--space-8);
  font-size: 13px;
  font-weight: 700;
  color: var(--color-accent);
}
</style>


{post.tags?.length > 0 && (
  <ul class="article__tags">
    {post.tags.map((tag) => (
      <li class="article__tag">{tag}</li>
    ))}
  </ul>
)}

